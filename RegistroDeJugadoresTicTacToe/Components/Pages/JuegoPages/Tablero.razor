@page "/tablero/{PartidaId:int}"
@using RegistroDeJugadoresTicTacToe.Models
@inject NavigationManager navigationManager
@inject IJugadoresApiService jugadoresApiService
@inject IPartidaApiService partidasApiService
@inject IMovimientosApiService movimientosApiService
@rendermode InteractiveServer

<div class="game-container">
    <div class="text">PartidaID: @PartidaId</div>
    <h2 class="game-status">@GameStatus</h2>
    <div class="game-screen">
        <div class="game-board">
            @for (var i = 0; i < 9; i++)
            {
                var cellIndex = i;
                <button class="cell @GetPlayerClass(board[cellIndex])"
                        @onclick="() => HandleCellClick(cellIndex)"
                        disabled="@(board[cellIndex] != null || winner != null || esEmpate)">
                    @board[cellIndex]?.ToString()
                </button>
            }
        </div>

        <button class="btn btn-secondary mt-4" @onclick="RestartGame">
            Reiniciar Juego
        </button>
    </div>
</div>

@code {
    private enum PlayerType { X, O }
    [Parameter]
    public int PartidaId { get; set; }
    

    private string? jugador1Nombre;
    private string? jugador2Nombre;

    private Partidas partida;
    private PlayerType?[] board = new PlayerType?[9];
    private PlayerType _currentPlayerType = PlayerType.X;
    private PlayerType? winner;
    private bool esEmpate;

    protected override async Task OnInitializedAsync()
    {
        await CargarTablero();
        winner = CheckForWinner();
        esEmpate = board.All(cell => cell != null);
        await CargarNombres();
    }
    public async Task CargarTablero()
    {
        var movimientos = await movimientosApiService.GetMovimientoAsync(PartidaId);
        foreach(var m in movimientos.Data)
        {
            board[(m.PosicionFila * 3) + m.PosicionColumna] = Enum.Parse<PlayerType>(m.Jugador);
            _currentPlayerType = Enum.Parse<PlayerType>(m.Jugador) == PlayerType.X ? PlayerType.O : PlayerType.X;
        }
    }
    public async Task CargarNombres()
    {
        var partida = (await partidasApiService.GetPartidaAsync(PartidaId)).Data;
        jugador1Nombre = (await jugadoresApiService.GetJugadoresAsync(partida.Jugador1Id)).Data.Nombres;
        jugador2Nombre = (await jugadoresApiService.GetJugadoresAsync(partida.Jugador2Id ?? 0)).Data.Nombres;
    }
    private string GameStatus
    {
        get
        {
            if (winner != null)
            {
                var ganadorNombre = (winner == PlayerType.X) ? jugador1Nombre : jugador2Nombre;
                return $"🏆 ¡Ganador: {ganadorNombre} ({winner})!";
            }
            if (esEmpate)
                return "🤝 ¡Es un empate!";
            var turnoNombre = (_currentPlayerType == PlayerType.X) ? jugador1Nombre : jugador2Nombre;
            return $"Turno de: {turnoNombre} ({_currentPlayerType})";
        }
    }

    private async Task HandleCellClick(int index)
    {
        if (board[index] != null || winner != null || esEmpate) return;

        board[index] = _currentPlayerType;


        await movimientosApiService.PostMovimiento(PartidaId, _currentPlayerType.ToString(), index/3, index % 3);
        
        winner = CheckForWinner();
        if (winner != null)
        {
            return;
        }

        esEmpate = board.All(cell => cell != null);
        if (esEmpate)
        {
            return;
        }
        _currentPlayerType = (_currentPlayerType == PlayerType.X) ? PlayerType.O : PlayerType.X;
    }


    private PlayerType? CheckForWinner()
    {
        var winningLines = new[]
        {
            new[] {0, 1, 2}, new[] {3, 4, 5}, new[] {6, 7, 8},
            new[] {0, 3, 6}, new[] {1, 4, 7}, new[] {2, 5, 8},
            new[] {0, 4, 8}, new[] {2, 4, 6}
        };

        foreach (var line in winningLines)
        {
            var (a, b, c) = (line[0], line[1], line[2]);
            if (board[a].HasValue && board[a] == board[b] && board[a] == board[c])
                return board[a];
        }
        return null;
    }

    private async Task RestartGame()
    {
        var partida = await partidasApiService.GetPartidaAsync(PartidaId);
        int jugador1Id = partida.Data.Jugador1Id;
        int? jugador2Id = partida.Data.Jugador2Id;
        var creado = await partidasApiService.PostPartida(jugador1Id, jugador2Id);
        if (creado is Resource<PartidaResponse>.Success ok)
        {
            navigationManager.NavigateTo($"/tablero/{ok.Data.PartidaId}");
        }
    }

    private string GetPlayerClass(PlayerType? player)
    {
        if (!player.HasValue) return "";
        return player == PlayerType.X ? "player-x" : "player-o";
    }
}


